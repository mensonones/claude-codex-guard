#!/usr/bin/env bash
# Claude-Codex-Guard git shim: limits unbounded log and diff floods
REAL_BIN=$(which -a git 2>/dev/null | grep -F -v "/shims/" | head -n 1)
REAL_BIN=${REAL_BIN:-/usr/bin/git}

SUBCOMMAND="$1"

# Optimize 'git log': ensure pagination/limit exists
if [ "$SUBCOMMAND" = "log" ]; then
  HAS_LIMIT=false
  for arg in "$@"; do
    case "$arg" in
      -n*|--max-count*|-[0-9]*)
        HAS_LIMIT=true
        break
        ;;
    esac
  done
  if [ "$HAS_LIMIT" = false ]; then
    exec "$REAL_BIN" "$@" -n 20
  fi
fi

# Optimize 'git diff': prevent 10,000 line diff explosions
if [ "$SUBCOMMAND" = "diff" ]; then
  TMP_OUT=$(mktemp)
  "$REAL_BIN" "$@" > "$TMP_OUT" 2>&1
  DIFF_LINES=$(wc -l < "$TMP_OUT" 2>/dev/null || echo 0)
  if [ "$DIFF_LINES" -gt 300 ]; then
    head -n 200 "$TMP_OUT"
    echo ""
    echo "[... claude-codex-guard git shim: diff grande com $DIFF_LINES linhas. Exibidas primeiras 200 linhas. Use 'git diff --stat' ou aponte arquivos específicos ...]"
    echo ""
    tail -n 50 "$TMP_OUT"
    rm -f "$TMP_OUT"
    exit 0
  fi
  cat "$TMP_OUT"
  rm -f "$TMP_OUT"
  exit 0
fi

exec "$REAL_BIN" "$@"
