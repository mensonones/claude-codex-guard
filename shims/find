#!/usr/bin/env bash
# Claude-Codex-Guard find shim: injects safe maxdepth and limits runaway file listing
REAL_BIN=$(which -a find 2>/dev/null | grep -F -v "/shims/" | head -n 1)
REAL_BIN=${REAL_BIN:-/usr/bin/find}

HAS_MAXDEPTH=false
for arg in "$@"; do
  if [ "$arg" = "-maxdepth" ]; then
    HAS_MAXDEPTH=true
    break
  fi
done

# Run with safety cap on max lines
TMP_OUT=$(mktemp)
if [ "$HAS_MAXDEPTH" = false ] && [ -d "$1" ]; then
  DIR="$1"
  shift
  "$REAL_BIN" "$DIR" -maxdepth 6 "$@" > "$TMP_OUT" 2>&1
else
  "$REAL_BIN" "$@" > "$TMP_OUT" 2>&1
fi

COUNT=$(wc -l < "$TMP_OUT" 2>/dev/null || echo 0)
if [ "$COUNT" -gt 80 ]; then
  head -n 80 "$TMP_OUT"
  echo ""
  echo "[... claude-codex-guard find shim: busca retornou $COUNT itens. Exibidos primeiros 80. Especifique pastas ou padrões com '-name' ...]"
else
  cat "$TMP_OUT"
fi

rm -f "$TMP_OUT"
